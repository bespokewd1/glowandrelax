---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import client from '@data/clientData';
// Optimize our landing image and pass it as props to the BaseLayout (for preloading) and Landing (for rendering)
import { getOptimizedImage } from '@js/utils';
import landingImage from '@assets/images/stone-massage-background1.png';
import FacebookIcon from '@components/Icons/Socials/FacebookIcon.astro';
import TwitterIcon from '@components/Icons/Socials/TwitterIcon.astro';
import LinkedInIcon from '@components/Icons/Socials/LinkedInIcon.astro';
import InstagramIcon from '@components/Icons/Socials/InstagramIcon.astro';
import CheckIcon from '@components/Icons/Utility/CheckIcon.astro';
import MapPinFilled from '@components/Icons/Utility/MapPinFilled.astro';

import { resolveImage } from '@js/imageUtils';
import type { GetImageResult } from 'astro';
import seoSetting from '@data/seo-pages.json';
import Button from '@components/Button.astro';
const seo = seoSetting.contact;
const ogImg = await resolveImage(seo.ogImage);
let ogImage: GetImageResult | null = null;
if (ogImg) {
  ogImage = await getOptimizedImage(ogImg);
}

type Social = {
  name: string;
  href: string;
  Icon: typeof FacebookIcon;
};

const optimizedImage = await getOptimizedImage(landingImage);

const phoneDisplay = client.phoneFormatted;
const phoneHref = `tel:${client.phoneForTel}`;
const email = client.email;
const emailHref = `mailto:${client.email}`;
const socials: Social[] = [
  { name: 'Facebook', href: client.socials.facebook, Icon: FacebookIcon },
  { name: 'Twitter/X', href: client.socials.twitter, Icon: TwitterIcon },
  { name: 'LinkedIn', href: client.socials.linkedin, Icon: LinkedInIcon },
  { name: 'Instagram', href: client.socials.instagram, Icon: InstagramIcon },
];

const clinicName = client.name || 'iMassage Therapeutic Clinique';
const address =
  client.address.lineOne?.trim() + ', ' + client.address.lineTwo?.trim();
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  client.address.lineOne + ' ' + client.address.lineTwo
)}`;

const hours = [
  { label: 'Mon – Sat', value: '10:00 am – 10:00 pm' },
  { label: 'Sunday', value: '3:00 pm – 10:00 pm' },
];

const reasons = [
  'Same‑day bookings may be available',
  'Secure online payments and multiple payment options',
  'Registered, professional massage therapists',
];
---

<BaseLayout
  title={seo.title || 'Contact'}
  description={seo.description}
  ogImage={ogImage}
  preloadedImage={optimizedImage}
>
  <!-- ============================================ -->
  <!--                S1 Hero / Intro               -->
  <!-- ============================================ -->
  <section class="bg-cream-50 relative isolate overflow-hidden">
    <!-- Ambient washes -->
    <div
      aria-hidden="true"
      class="bg-copper-200/40 pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="bg-sage-200/50 pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full blur-3xl"
    >
    </div>

    <div
      class="relative mx-auto grid max-w-7xl grid-cols-1 gap-y-10 px-6 pt-14 pb-20 lg:grid-cols-12 lg:gap-x-12 lg:px-16"
    >
      <!-- Left: image with offset frame -->
      <div class="relative lg:col-span-7">
        <div
          aria-hidden="true"
          class="border-copper-400/70 absolute inset-0 -top-5 -left-5 hidden border lg:block"
        >
        </div>
        <img
          src={optimizedImage.src}
          width={optimizedImage.attributes.width}
          height={optimizedImage.attributes.height}
          alt="Warm stones arranged on a folded towel beside a softly lit window"
          class="relative block aspect-[4/3] w-full rounded-sm object-cover shadow-[0_30px_70px_-25px_rgba(60,49,40,0.45)] md:aspect-[16/10] lg:aspect-auto lg:h-[520px]"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Right: copy -->
      <div class="lg:col-span-5 lg:flex lg:flex-col lg:justify-center">
        <div class="flex items-center gap-3">
          <span class="bg-copper-500 h-px w-8"></span>
          <span
            class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
          >
            Get in touch
          </span>
        </div>
        <h1
          class="text-taupe-900 mt-5 font-serif text-[clamp(2.4rem,5vw,3.75rem)] leading-[1.05] tracking-[-0.01em]"
        >
          Book Your <em class="text-copper-600 italic">Massage</em> Today
        </h1>
        <p class="text-taupe-700 mt-5 leading-7">
          Have questions about our therapeutic massage services, pricing, or
          mobile availability? Our team is happy to assist. Reach out to book an
          appointment or ask about the best treatment for your needs.
        </p>

        <ul class="text-taupe-800 mt-7 space-y-3">
          {
            reasons.map((reason) => (
              <li class="flex items-start gap-3">
                <CheckIcon class="text-copper-500 mt-1" />
                <span class="leading-7">{reason}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a
            href={phoneHref}
            class="group border-taupe-200 bg-cream-50 hover:border-copper-400 rounded-sm border px-5 py-4 transition-all hover:-translate-y-0.5 hover:shadow-[0_20px_40px_-20px_rgba(60,49,40,0.3)]"
          >
            <span
              class="text-copper-700 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
              >Phone</span
            >
            <span
              class="text-taupe-900 group-hover:text-copper-700 mt-1 block font-serif text-lg"
              >{phoneDisplay}</span
            >
          </a>
          <a
            href={emailHref}
            class="group border-taupe-200 bg-cream-50 hover:border-copper-400 rounded-sm border px-5 py-4 transition-all hover:-translate-y-0.5 hover:shadow-[0_20px_40px_-20px_rgba(60,49,40,0.3)]"
          >
            <span
              class="text-copper-700 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
              >Email</span
            >
            <span
              class="text-taupe-900 group-hover:text-copper-700 mt-1 block truncate font-serif text-lg"
              >{email}</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--           S2 Contact Info + Form             -->
  <!-- ============================================ -->
  <section id="contact" class="bg-cream-50">
    <div class="mx-auto grid grid-cols-1 lg:grid-cols-12">
      <!-- Left: Sage info panel -->
      <div
        class="bg-sage-700 text-cream-50 relative flex flex-col justify-center overflow-hidden px-8 py-14 md:px-12 md:py-20 lg:col-span-5"
      >
        <svg
          aria-hidden="true"
          class="text-sage-500/30 pointer-events-none absolute -top-10 -right-10 h-64 w-64"
          viewBox="0 0 200 200"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <circle cx="100" cy="100" r="80"></circle>
          <circle cx="100" cy="100" r="60"></circle>
          <circle cx="100" cy="100" r="40"></circle>
        </svg>

        <div class="relative max-w-md">
          <div class="flex items-center gap-3">
            <span class="bg-copper-300 h-px w-8"></span>
            <span
              class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Reach out
            </span>
          </div>
          <h2
            class="text-cream-50 mt-5 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
          >
            We're here to <em class="text-copper-300 italic">help</em>
          </h2>

          <div class="text-cream-100/90 mt-8 space-y-4">
            <p class="text-cream-50 font-serif text-xl italic">{clinicName}</p>
            <div class="space-y-2 text-sm leading-6">
              <p>
                {client.address.lineOne}<br />
                {client.address.lineTwo}
              </p>
              <p>
                <a
                  href={phoneHref}
                  class="hover:text-copper-200 block transition"
                >
                  <span class="text-copper-300">P.</span>
                  {phoneDisplay}
                </a>
                <a
                  href={emailHref}
                  class="hover:text-copper-200 block transition"
                >
                  <span class="text-copper-300">E.</span>
                  {email}
                </a>
              </p>
              <div class="border-cream-100/15 border-t pt-3">
                <p class="text-copper-200 text-xs tracking-[0.3em] uppercase">
                  Hours
                </p>
                <ul class="mt-2 space-y-1">
                  {
                    hours.map((h) => (
                      <li class="flex items-center gap-4">
                        <span class="text-cream-50 min-w-20 font-medium">
                          {h.label}
                        </span>
                        <span class="text-cream-100/90">{h.value}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <p class="text-cream-100/70 text-xs leading-5 italic">
                Direct billing available. Please ask about eligible providers.
              </p>
            </div>
          </div>

          <!-- Socials -->
          <div class="mt-10 flex items-center gap-3">
            {
              socials.map(({ name, href, Icon }) => (
                <a
                  href={href}
                  aria-label={name}
                  class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
                >
                  <Icon class:list={['text-cream-50']} />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-cream-50 px-8 py-14 md:px-12 md:py-20 lg:col-span-7">
        <div class="mx-auto max-w-2xl">
          <div class="flex items-center gap-3">
            <span class="bg-copper-500 h-px w-8"></span>
            <span
              class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Send a message
            </span>
          </div>
          <h3
            class="text-taupe-900 mt-4 font-serif text-2xl tracking-[-0.01em] md:text-3xl"
          >
            Tell us how we can help.
          </h3>

          <form class="mt-8" onsubmit="event.preventDefault();">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <div>
                <label
                  class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                  >First Name</label
                >
                <input
                  type="text"
                  class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                  placeholder="Jane"
                />
              </div>
              <div>
                <label
                  class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                  >Last Name</label
                >
                <input
                  type="text"
                  class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                  placeholder="Doe"
                />
              </div>
            </div>

            <div class="mt-6">
              <label
                class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                >Email *</label
              >
              <input
                type="email"
                required
                class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                placeholder="you@example.com"
              />
            </div>

            <div class="mt-6">
              <label
                class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                >Message</label
              >
              <textarea
                rows="5"
                class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full resize-none border-b bg-transparent px-1 py-2 transition focus:outline-none"
                placeholder="How can we help?"></textarea>
            </div>

            <Button class="mt-4" type="submit" icon="tabler:send-filled">
              Send Message
            </Button>
            <!-- <button
              type="submit"
              class="group mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-copper-500 px-8 py-3.5 text-sm font-semibold tracking-wide text-cream-50 shadow-lg shadow-copper-500/25 transition-all hover:-translate-y-0.5 hover:bg-copper-600 hover:shadow-copper-600/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-copper-700 md:w-auto"
            >
              Send Message
              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1">→</span
              >
            </button> -->
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!--             S3 Visit Us + Map                -->
  <!-- ============================================ -->
  <section class="bg-cream-100">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 py-16 md:py-20 lg:grid-cols-12 lg:px-16"
    >
      <!-- Left: address + hours -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <span class="bg-sage-600 h-px w-8"></span>
          <span
            class="text-sage-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
          >
            Visit us
          </span>
        </div>
        <h2
          class="text-taupe-900 mt-4 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
        >
          Find us <em class="text-copper-600 italic">in‑clinic</em>
        </h2>
        <p class="text-taupe-700 mt-4 leading-7">
          Our licensed therapists provide personalized therapeutic care—deep
          tissue, relaxation, and hot stone therapy—in a calm, welcoming space.
          Easy to find, always happy to help you feel your best.
        </p>

        <div class="mt-8 space-y-5">
          <!-- Address card -->
          <div
            class="group border-taupe-200 bg-cream-50 hover:border-copper-400 rounded-sm border p-6 transition-all hover:-translate-y-1 hover:shadow-[0_30px_50px_-25px_rgba(60,49,40,0.35)]"
          >
            <span
              class="text-copper-700 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
              >Address</span
            >
            <p
              class="text-taupe-900 mt-3 inline-flex items-center gap-2 font-serif text-lg"
            >
              <span class="text-copper-500">
                <MapPinFilled />
              </span>
              {clinicName}
            </p>
            <a
              href={mapHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-copper-700 hover:text-copper-600 mt-2 block underline-offset-4 transition hover:underline"
            >
              {address}
            </a>
          </div>

          <!-- Hours card -->
          <div
            class="group border-taupe-200 bg-cream-50 hover:border-copper-400 rounded-sm border p-6 transition-all hover:-translate-y-1 hover:shadow-[0_30px_50px_-25px_rgba(60,49,40,0.35)]"
          >
            <span
              class="text-copper-700 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
              >Opening Hours</span
            >
            <ul class="text-taupe-900 mt-3 space-y-2">
              {
                hours.map((h) => (
                  <li class="flex items-center gap-6">
                    <span class="min-w-20 font-serif text-base font-semibold">
                      {h.label}
                    </span>
                    <span class="text-taupe-700">{h.value}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Right: map -->
      <div class="lg:col-span-7">
        <div class="relative">
          <div
            aria-hidden="true"
            class="border-copper-400/70 absolute inset-0 -top-4 -left-4 hidden border lg:block"
          >
          </div>
          <div
            class="ring-taupe-200 relative overflow-hidden rounded-sm shadow-[0_30px_60px_-25px_rgba(60,49,40,0.4)] ring-1"
          >
            <iframe
              src={client.address.mapLink}
              style="border:0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-[420px] w-full lg:h-[520px]"
              title="Map showing clinic location"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
