---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import CTA from '@components/CTA.astro';
import whyChooseImg from '@assets/images/why-choose.webp';

import { getOptimizedImage } from '@js/utils';
import { getPageSeo } from '@lib/seo';
const { seo, ogImage } = await getPageSeo('about');
import WhyChooseUs from '@components/why-choose-us.astro';
import { getCollection } from 'astro:content';

type Role = 'Marianne/Founder RMT' | 'Therapist';

// Load team from content collection
const teamEntries = await getCollection('team');
// Map + sort: founders first, then therapists,
// and within each group sort by `order` then `name`
const orderedTeam = teamEntries
  .map((entry) => ({
    name: entry.data.name,
    role: entry.data.role, // 'founder' | 'therapist'
    occupation: entry.data.occupation,
    since: entry.data.since,
    where: entry.data.where,
    bio: entry.data.bio,
  }))
  .sort((a, b) => {
    // 1) Founders first
    if (a.role === 'founder' && b.role !== 'founder') return -1;
    if (b.role === 'founder' && a.role !== 'founder') return 1;

    // 2) Tiebreaker by name
    return a.name.localeCompare(b.name);
  });
const whyChooseImage = await getOptimizedImage(whyChooseImg);

// usage for promos
const allPromos = await getCollection('promotions');
const now = new Date();

// show only active & currently valid
const promotions = allPromos.filter(({ data }) => {
  if (!data.active) return false;
  const startOk = data.startDate <= now;
  const endOk = !data.endDate || data.endDate >= now;
  return startOk && endOk;
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={ogImage}
  preloadedImage={whyChooseImage}
>
  <!-- ============================================ -->
  <!--                     Team                     -->
  <!-- ============================================ -->

  <section class="bg-orange-50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-serif text-3xl text-gray-950 md:text-5xl">
          Meet Our Expert Therapists
        </h1>
        <p class="mt-4 leading-7 text-gray-700">
          Our team at Glow and Relax is dedicated to thoughtful,
          results‑focused massage care. We tailor every session to your goals so
          you can leave lighter, looser, and genuinely restored.
        </p>
      </div>

      <!-- Cards -->
      <div
        class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"
      >
        {
          orderedTeam.map((m) => (
            <article class="rounded-lg bg-orange-200/90 p-6 shadow-sm ring-1 ring-black/5">
              <div class="mb-3">
                <span
                  class:list={[
                    'inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wide',
                    m.role === 'founder'
                      ? 'bg-emerald-900 text-emerald-50'
                      : 'bg-emerald-200 text-emerald-900',
                  ]}
                >
                  {m.role === 'founder' ? 'Founder RMT' : 'Therapist'}
                </span>
              </div>

              <div class="space-y-2">
                <p class="text-sm text-gray-700">{m.occupation}</p>
                <p class="text-xs text-gray-700">
                  {m.since}
                  {m.where ? ' • ' + m.where : ''}
                </p>
                <h3 class="font-semibold text-gray-900">{m.name}</h3>
              </div>

              <p class="mt-4 text-sm leading-6 text-gray-800">{m.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Relief for Your Body, Calm for Your Mind"
    description="Personalized care that eases pain and restores well‑being."
  />
  <WhyChooseUs />
</BaseLayout>
