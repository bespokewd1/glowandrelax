---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import CTA from '@components/CTA.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { Image } from 'astro-lqip/components';
import client from '@data/clientData';
import homeData from '@data/home.json';

// Optimize images for social previews and preloading.
import { resolveImage } from '@js/imageUtils';
import { getPageSeo } from '@lib/seo';
const { seo, ogImage } = await getPageSeo('home');

// import heroImg from '@assets/images/home/hero-img1.jpg';
import FacebookIcon from '@components/Icons/Socials/FacebookIcon.astro';
import InstagramIcon from '@components/Icons/Socials/InstagramIcon.astro';
import LinkedInIcon from '@components/Icons/Socials/LinkedInIcon.astro';
import TwitterIcon from '@components/Icons/Socials/TwitterIcon.astro';
import WhyChooseUs from '@components/why-choose-us.astro';
import CtaLink from '@components/CtaLink.astro';
import Hero from '@components/Hero.astro';
import Button from '@components/Button.astro';

const heroImg = await resolveImage(homeData.hero.image);
const welcomeImage = await resolveImage(homeData.welcome.image);

const heroWidths = [480, 640, 768, 960, 1200, 1536];
// Account for the landscape photo's object-cover crop inside the portrait frame.
const heroSizes =
  '(min-width: 1280px) 1174px, (min-width: 1024px) calc(105vw - 170.4px), (min-width: 720px) 756px, (min-width: 640px) calc(112.5vw - 54px), calc(187.5vw - 90px)';
const heroImage = heroImg
  ? await getImage({
      src: heroImg,
      format: 'webp',
      widths: heroWidths,
      sizes: heroSizes,
    })
  : null;
const serviceImageWidths = [480, 640, 768, 960, 1200, 1280, 1536];
const serviceImageSizes =
  '(min-width: 1280px) 640px, (min-width: 1260px) 50vw, (min-width: 768px) 630px, 100vw';

const allServices = await getCollection('services');

// Look for the service where the Title matches what was saved in home.json
const highlight1 = allServices.find(
  (s) => s.data.title === homeData.serviceHighlights.highlight1
);
const highlight2 = allServices.find(
  (s) => s.data.title === homeData.serviceHighlights.highlight2
);
---

<!-- Font Awesome is intentionally NOT loaded here: this page renders its
     social icons as self-contained SVG components, so the CDN stylesheet
     would be unused render-blocking weight. -->

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={ogImage}
  preloadedImage={heroImage ?? undefined}
>
  <!-- ============================================ -->
  <!--                    Hero                      -->
  <!-- ============================================ -->

  <Hero heroImg={heroImg} heroImage={heroImage} welcomeImage={welcomeImage} />

  <!-- ================= CTA (Green band) ================ -->
  <CTA
    title={homeData.greenCta.title}
    description={homeData.greenCta.description}
  />

  <!-- ================= Services ================= -->
  <section class="bg-cream-50">
    <!-- Intro -->
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 flex items-center justify-center gap-3">
          <span class="bg-copper-500 h-px w-8"></span>
          <span
            class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
          >
            Treatments
          </span>
          <span class="bg-copper-500 h-px w-8"></span>
        </div>
        <h2
          class="text-taupe-900 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
        >
          {homeData.serviceHighlights.heading}
        </h2>
        <p class="text-taupe-700 mx-auto mt-4 max-w-2xl leading-7">
          {homeData.serviceHighlights.description}
        </p>
      </div>
    </div>

    <!-- Image row with overlay card on sage tone -->
    <div class="mx-auto max-w-7xl px-0">
      <div class="grid grid-cols-1 items-stretch md:grid-cols-12">
        <!-- Left image -->
        {
          highlight1 && (
            <>
              <div class="md:col-span-6">
                <Image
                  src={highlight1.data.image}
                  widths={serviceImageWidths}
                  sizes={serviceImageSizes}
                  alt={highlight1.data.imageAlt}
                  class="block aspect-[16/10] w-full object-cover md:aspect-auto md:h-[420px]"
                  lqip="base64"
                  lqipSize={10}
                />
              </div>

              <div class="bg-sage-100 flex items-center justify-center px-6 py-10 md:col-span-6 md:px-12">
                <div class="w-full max-w-xl text-center md:text-left">
                  <span class="text-sage-700 text-[0.65rem] font-medium tracking-[0.4em] uppercase">
                    01 — Therapeutic
                  </span>
                  <h3 class="text-taupe-900 mt-3 font-serif text-2xl tracking-tight md:text-3xl">
                    {highlight1.data.title}
                  </h3>
                  <p class="text-taupe-700 mt-4 leading-7">
                    {highlight1.data.subtitle}
                  </p>
                  <div class="mt-6">
                    <Button as="a" href="/services" variant="outline">
                      View Services
                    </Button>
                  </div>
                </div>
              </div>
            </>
          )
        }

        <!-- Right image -->
        {
          highlight2 && (
            <>
              <div class="md:col-span-12">
                <div class="grid grid-cols-1 md:grid-cols-12">
                  <div class="order-2 md:order-1 md:col-span-6">
                    <div class="bg-cream-100 flex h-full w-full items-center justify-center px-6 py-10 md:px-12">
                      <div class="w-full max-w-xl text-center md:text-left">
                        <span class="text-copper-700 text-[0.65rem] font-medium tracking-[0.4em] uppercase">
                          02 — Relaxation
                        </span>
                        <h3 class="text-taupe-900 mt-3 font-serif text-2xl tracking-tight md:text-3xl">
                          {highlight2.data.title}
                        </h3>
                        <p class="text-taupe-700 mt-4 leading-7">
                          {highlight2.data.subtitle}
                        </p>
                        <div class="mt-6">
                          <Button as="a" href="/services" variant="outline">
                            Explore Massage Treatments
                          </Button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="order-1 md:order-2 md:col-span-6">
                    <Image
                      src={highlight2.data.image}
                      widths={serviceImageWidths}
                      sizes={serviceImageSizes}
                      alt={highlight2.data.imageAlt}
                      class="block aspect-[16/10] w-full object-cover md:aspect-auto md:h-[420px]"
                      lqip="base64"
                      lqipSize={10}
                    />
                  </div>
                </div>
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>

  <!-- ================= Why Choose Us ================= -->
  <WhyChooseUs />

  <!-- ================= How to Book (Steps) ================= -->
  <section class="bg-cream-100 relative">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="text-center">
        <div class="mb-4 flex items-center justify-center gap-3">
          <span class="bg-sage-600 h-px w-8"></span>
          <span
            class="text-sage-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
          >
            Three steps
          </span>
          <span class="bg-sage-600 h-px w-8"></span>
        </div>
        <h2
          class="text-taupe-900 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
        >
          {homeData.bookingSteps.title}
        </h2>
      </div>

      <!-- Steps -->
      <div
        class="mt-12 grid grid-cols-1 gap-6 md:mt-14 md:grid-cols-3 md:gap-6"
      >
        {
          homeData.bookingSteps.steps.map((step) => (
            <div class="group border-taupe-200 bg-cream-50 hover:border-copper-400 relative overflow-hidden rounded-sm border px-8 py-10 text-center transition-all hover:-translate-y-1 hover:shadow-[0_30px_50px_-25px_rgba(60,49,40,0.35)]">
              <div
                aria-hidden="true"
                class="text-copper-500/10 pointer-events-none absolute -top-2 -right-2 font-serif text-[7rem] leading-none italic select-none"
              >
                {step.num}
              </div>
              <div class="relative">
                <div class="border-copper-500 text-copper-600 mx-auto flex h-12 w-12 items-center justify-center rounded-full border font-serif text-xl italic">
                  {step.num}
                </div>
                <h3 class="text-taupe-900 mt-5 font-serif text-2xl tracking-tight md:text-3xl">
                  {step.title}
                </h3>
                <p class="text-taupe-700 mt-3 leading-7">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Direct billing + CTA -->
      <div class="mt-14 text-center">
        <p class="text-taupe-900 font-serif text-xl italic">
          {homeData.bookingSteps.billingText}
        </p>
        <p class="text-taupe-600 mt-1 text-sm">
          {homeData.bookingSteps.billingSub}
        </p>

        <CtaLink />
      </div>
    </div>
  </section>

  <!-- ================= Contact / Get in Touch ================= -->
  <section id="contact" class="bg-cream-50">
    <div class="mx-auto grid grid-cols-1 lg:grid-cols-12">
      <!-- Left: Info panel (sage) -->
      <div
        class="bg-sage-700 text-cream-50 relative flex flex-col justify-center overflow-hidden px-8 py-14 md:px-12 md:py-20 lg:col-span-5"
      >
        <!-- Decorative SVG -->
        <svg
          aria-hidden="true"
          class="text-sage-500/30 pointer-events-none absolute -top-10 -right-10 h-64 w-64"
          viewBox="0 0 200 200"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <circle cx="100" cy="100" r="80"></circle>
          <circle cx="100" cy="100" r="60"></circle>
          <circle cx="100" cy="100" r="40"></circle>
        </svg>

        <div class="relative max-w-md">
          <div class="flex items-center gap-3">
            <span class="bg-copper-300 h-px w-8"></span>
            <span
              class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Reach out
            </span>
          </div>
          <h2
            class="text-cream-50 mt-5 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
          >
            Get in <em class="text-copper-300 italic">Touch</em>
          </h2>

          <div class="text-cream-100/90 mt-8 space-y-4">
            <p class="text-cream-50 font-serif text-xl italic">
              {client.name}
            </p>
            <div class="space-y-2 text-sm leading-6">
              <p class="text-cream-100/85">
                {client.address.lineOne}<br />
                {client.address.lineTwo}
              </p>
              <p class="text-cream-100/85">
                <span class="text-copper-200">P.</span>
                {client.phoneFormatted}<br />
                <span class="text-copper-200">E.</span>
                {client.email}
              </p>
              <p class="border-cream-100/15 text-cream-100/85 border-t pt-3">
                <span class="text-copper-200">Hours.</span>
                {client.openingHours.daysOpen}: {client.openingHours.hours}
              </p>
              <p class="text-cream-100/85 text-xs leading-5 italic">
                Direct Billing Available. Please ask about eligible providers.
              </p>
            </div>
          </div>

          <!-- Socials -->
          <div class="mt-10 flex items-center gap-3">
            <a
              href={client.socials.facebook}
              aria-label="Facebook"
              class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
            >
              <FacebookIcon class:list={['text-cream-50']} />
            </a>
            <a
              href={client.socials.instagram}
              aria-label="Instagram"
              class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
            >
              <InstagramIcon class:list={['text-cream-50']} />
            </a>
            <a
              href={client.socials.linkedin}
              aria-label="LinkedIn"
              class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
            >
              <LinkedInIcon class:list={['text-cream-50']} />
            </a>
            <a
              href={client.socials.twitter}
              aria-label="Twitter"
              class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
            >
              <TwitterIcon class:list={['text-cream-50']} />
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-cream-50 px-8 py-14 md:px-12 md:py-20 lg:col-span-7">
        <div class="mx-auto max-w-2xl">
          <div class="flex items-center gap-3">
            <span class="bg-copper-500 h-px w-8"></span>
            <span
              class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Send a message
            </span>
          </div>
          <h3
            class="text-taupe-900 mt-4 font-serif text-2xl tracking-[-0.01em] md:text-3xl"
          >
            Tell us how we can help.
          </h3>

          <form class="mt-8">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <div>
                <label
                  class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                  >First Name</label
                >
                <input
                  type="text"
                  class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                  placeholder="Jane"
                />
              </div>
              <div>
                <label
                  class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                  >Last Name</label
                >
                <input
                  type="text"
                  class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                  placeholder="Doe"
                />
              </div>
            </div>

            <div class="mt-6">
              <label
                class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                >Email *</label
              >
              <input
                type="email"
                required
                class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full border-b bg-transparent px-1 py-2 transition focus:outline-none"
                placeholder="you@example.com"
              />
            </div>

            <div class="mt-6">
              <label
                class="text-taupe-600 mb-2 block text-[0.65rem] font-medium tracking-[0.3em] uppercase"
                >Message</label
              >
              <textarea
                rows="5"
                class="border-taupe-300 text-taupe-900 placeholder:text-taupe-400 focus:border-copper-500 w-full resize-none border-b bg-transparent px-1 py-2 transition focus:outline-none"
                placeholder="How can we help?"></textarea>
            </div>

            <Button type="submit" icon="tabler:send-filled">
              Send Message
            </Button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
