---
import CtaLink from './CtaLink.astro';
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="bg-sage-700 text-cream-50 relative isolate overflow-hidden">
  <!-- ambient washes -->
  <div
    aria-hidden="true"
    class="bg-sage-500/40 pointer-events-none absolute -top-24 -left-24 -z-10 h-[28rem] w-[28rem] rounded-full blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="bg-copper-500/20 pointer-events-none absolute -right-24 -bottom-24 -z-10 h-[28rem] w-[28rem] rounded-full blur-3xl"
  >
  </div>

  <!-- decorative concentric circles -->
  <svg
    aria-hidden="true"
    class="text-cream-50/10 pointer-events-none absolute top-1/2 left-8 -z-10 h-48 w-48 -translate-y-1/2 lg:h-64 lg:w-64"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
  >
    <circle cx="100" cy="100" r="80"></circle>
    <circle cx="100" cy="100" r="60"></circle>
    <circle cx="100" cy="100" r="40"></circle>
  </svg>

  <div
    class="relative mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-16 text-center md:py-20 lg:py-24"
  >
    <div class="flex items-center gap-3">
      <span class="bg-copper-300 h-px w-8"></span>
      <span
        class="text-cream-50 text-[0.7rem] font-medium tracking-[0.45em] uppercase"
      >
        Begin your journey
      </span>
      <span class="bg-copper-300 h-px w-8"></span>
    </div>

    <h2
      class="text-cream-50 font-serif text-4xl leading-[1.05] tracking-[-0.01em] italic md:text-5xl lg:text-6xl"
    >
      {title}
    </h2>
    <p class="text-cream-100/90 max-w-xl leading-7">
      {description}
    </p>

    <CtaLink />
  </div>
</section>
