---
import { Image } from 'astro-lqip/components';
// import whyChooseImg from '@assets/images/home/why-choose.webp';
import homeData from '@data/home.json';
import { resolveImage } from '@js/imageUtils';

const whyChooseImg = await resolveImage(homeData.whyChooseUs.image);
---

<section id="why-choose-us" class="bg-cream-50 px-0">
  <div
    class="relative mx-auto grid grid-cols-6 items-stretch gap-0 px-6 py-16 md:py-20 lg:py-24"
  >
    <!-- Left image -->
    <div
      class="relative col-span-full xl:col-start-2 xl:col-end-4 xl:justify-self-end"
    >
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -top-5 -left-5 -z-10 hidden h-full w-full max-w-[600px] border border-copper-400/60 xl:block"
        >
        </div>
        {
          whyChooseImg && (
            <Image
              src={whyChooseImg}
              class="mx-auto block aspect-square w-full max-w-[600px] object-cover shadow-[0_30px_60px_-25px_rgba(60,49,40,0.4)] lg:h-full xl:ms-0"
              alt={homeData.whyChooseUs.alt}
              lqip="base64"
              lqipSize={10}
            />
          )
        }
      </div>
    </div>

    <!-- Card with bullets -->
    <div
      class="relative inset-0 col-span-full mx-auto flex items-center py-12 md:px-6 xl:absolute xl:col-start-4 xl:col-end-7 xl:mx-0 xl:justify-self-start"
    >
      <div
        class="w-full max-w-[680px] rounded-sm border border-taupe-200 bg-cream-100 shadow-[0_25px_50px_-20px_rgba(60,49,40,0.3)]"
      >
        <div class="p-6 sm:p-8 md:p-10">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-copper-500"></span>
            <span
              class="text-[0.7rem] font-medium tracking-[0.4em] text-copper-700 uppercase"
            >
              Why us
            </span>
          </div>

          <h3
            class="mt-4 font-serif text-[clamp(var(--text-2xl),5vw,var(--text-4xl))] leading-[1.05] tracking-[-0.01em] text-taupe-900"
          >
            {homeData.whyChooseUs.title}
          </h3>

          <p class="mt-5 leading-7 text-taupe-700">
            {homeData.whyChooseUs.description}
          </p>

          <ul class="mt-7 space-y-4 text-taupe-800">
            {
              homeData.whyChooseUs.points.map((point, i) => (
                <li class="flex items-start gap-4">
                  <span
                    aria-hidden="true"
                    class={`mt-2 h-1 w-6 flex-none ${i % 2 === 0 ? 'bg-copper-500' : 'bg-sage-500'}`}
                  />
                  <span class="leading-6">{point.text}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-9">
            <a
              href="/about"
              class="group inline-flex items-center gap-2 rounded-full border border-taupe-900 px-6 py-3 text-sm font-medium text-taupe-900 transition-colors hover:bg-taupe-900 hover:text-cream-50"
            >
              Learn More
              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
