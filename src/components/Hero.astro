---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro-lqip/components';
import homeData from '@data/home.json';
import CtaLink from '@components/CtaLink.astro';
import Button from './Button.astro';

interface Props {
  heroImg: ImageMetadata | null;
  welcomeImage: ImageMetadata | null;
}

const { heroImg, welcomeImage } = Astro.props;
---

<section
  id="hero"
  class="bg-cream-50 text-taupe-800 relative isolate overflow-hidden"
>
  <!-- Ambient color washes -->
  <div
    aria-hidden="true"
    class="bg-copper-200/40 pointer-events-none absolute -top-40 -right-40 -z-10 h-[42rem] w-[42rem] rounded-full blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="bg-sage-200/50 pointer-events-none absolute top-[40%] -left-48 -z-10 h-[36rem] w-[36rem] rounded-full blur-3xl"
  >
  </div>

  <!-- Grain texture -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.07] mix-blend-multiply"
    xmlns="http://www.w3.org/2000/svg"
  >
    <filter id="hero-noise">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        stitchTiles="stitch"></feTurbulence>
      <feColorMatrix
        values="0 0 0 0 0.4
                0 0 0 0 0.27
                0 0 0 0 0.18
                0 0 0 0.7 0"
      ></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#hero-noise)"></rect>
  </svg>

  <!-- Vertical brand label -->
  <div
    aria-hidden="true"
    class="text-copper-700/70 pointer-events-none absolute top-1/2 left-4 z-20 hidden -translate-y-1/2 rotate-180 text-[0.65rem] font-medium tracking-[0.45em] uppercase [writing-mode:vertical-rl] lg:block"
  >
    Glow · Relax · Restore
  </div>

  <!-- ============================================ -->
  <!--                TOP HERO BLOCK                 -->
  <!-- ============================================ -->
  <div
    class="relative mx-auto grid max-w-7xl grid-cols-12 items-center gap-y-16 px-6 pt-14 pb-24 lg:gap-x-12 lg:px-16 lg:pt-20 lg:pb-32"
  >
    <!-- LEFT: image w/ decorative copper rule -->
    <div class="hero-rise hero-rise-img relative col-span-12 lg:col-span-7">
      <!-- offset frame -->
      <div
        aria-hidden="true"
        class="border-copper-400/70 absolute -top-5 -left-5 -z-10 hidden h-full w-full border lg:block"
      >
      </div>

      <div
        class="relative overflow-hidden rounded-sm shadow-[0_30px_70px_-25px_rgba(60,49,40,0.45)]"
      >
        {
          heroImg && (
            <Image
              src={heroImg}
              class="block aspect-[4/5] h-full w-full object-cover lg:aspect-[5/6]"
              alt={homeData.hero.alt}
              loading={'eager'}
              decoding="sync"
              fetchpriority="high"
              lqip="base64"
              lqipSize={10}
            />
          )
        }

        <!-- top-left chip -->
        <div
          class="border-cream-200 bg-cream-50/85 absolute top-5 left-5 flex items-center gap-2 border px-3 py-1.5 backdrop-blur-md"
        >
          <span class="bg-copper-500 h-1.5 w-1.5 rounded-full"></span>
          <span
            class="text-taupe-800 text-[0.6rem] font-medium tracking-[0.3em] uppercase"
          >
            Edmonton · since 2018
          </span>
        </div>

        <!-- bottom-right rating chip -->
        <div
          class="border-cream-200 bg-cream-50/85 absolute right-5 bottom-5 flex items-center gap-3 border px-4 py-2 backdrop-blur-md"
        >
          <span class="text-copper-500 text-sm tracking-[0.15em]">★★★★★</span>
          <span
            class="text-taupe-800 text-[0.6rem] font-medium tracking-[0.25em] uppercase"
          >
            4.9 · 200+ reviews
          </span>
        </div>
      </div>

      <!-- Decorative slash numeral -->
      <div
        aria-hidden="true"
        class="text-copper-500/15 pointer-events-none absolute -bottom-12 left-2 font-serif text-[10rem] leading-none italic select-none lg:text-[12rem]"
      >
        /01
      </div>
    </div>

    <!-- RIGHT: copy -->
    <div class="relative col-span-12 lg:col-span-5 lg:pl-6">
      <!-- kicker -->
      <div class="hero-rise hero-rise-1 flex items-center gap-3">
        <span class="bg-copper-500 h-px w-10"></span>
        <span
          class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
        >
          01 — Therapeutic Care
        </span>
      </div>

      <!-- headline -->
      <h1
        class="hero-rise hero-rise-2 text-taupe-900 mt-7 font-serif text-[clamp(2.6rem,5.5vw,4.75rem)] leading-[1.02] tracking-[-0.01em]"
      >
        Your Path to
        <span class="text-copper-600 block italic">Relaxation</span>
        <span class="block">Starts Here.</span>
      </h1>

      <!-- decorative tagline -->
      <div class="hero-rise hero-rise-3 mt-7 flex items-center gap-3">
        <span class="bg-taupe-400 h-px w-7"></span>
        <span
          class="text-taupe-600 text-[0.7rem] font-medium tracking-[0.35em] uppercase"
        >
          Restore · Renew · Rebalance
        </span>
      </div>

      <p
        class="hero-rise hero-rise-4 text-taupe-700 mt-6 max-w-md text-base leading-7"
      >
        {homeData.hero.subtitle}
      </p>

      <!-- CTAs -->
      <div class="hero-rise hero-rise-5 mt-9 flex flex-wrap items-center gap-3">
        <CtaLink />
        <!-- <CtaLink
          class="group bg-copper-500 text-cream-50 shadow-copper-500/25 hover:bg-copper-600 hover:shadow-copper-600/30 focus-visible:ring-copper-700 focus-visible:ring-offset-cream-50 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold tracking-wide shadow-lg transition-all hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
        /> -->
        <!-- <a
          href="https://imassagetherapeuticclinique.massagespotlight.com/firstvisit"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 rounded-full border border-taupe-800/40 px-7 py-3.5 text-sm font-medium text-taupe-900 transition-colors hover:border-taupe-900 hover:bg-taupe-900 hover:text-cream-50"
        >
          Get 20% OFF First Visit
          <span
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          >→</span>
        </a> -->
      </div>

      <!-- trust strip -->
      <dl
        class="hero-rise hero-rise-6 border-taupe-200 mt-14 grid grid-cols-3 gap-4 border-t pt-7"
      >
        <div>
          <dt class="text-copper-600 font-serif text-2xl italic">2,500+</dt>
          <dd
            class="text-taupe-600 mt-1 text-[0.6rem] font-medium tracking-[0.3em] uppercase"
          >
            Sessions
          </dd>
        </div>
        <div>
          <dt class="text-copper-600 font-serif text-2xl italic">RMT</dt>
          <dd
            class="text-taupe-600 mt-1 text-[0.6rem] font-medium tracking-[0.3em] uppercase"
          >
            Registered
          </dd>
        </div>
        <div>
          <dt class="text-copper-600 font-serif text-2xl italic">Direct</dt>
          <dd
            class="text-taupe-600 mt-1 text-[0.6rem] font-medium tracking-[0.3em] uppercase"
          >
            Billing
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- DIVIDER -->
  <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
    <div class="flex items-center gap-6">
      <span class="bg-taupe-200 h-px flex-1"></span>
      <span
        class="text-taupe-500 text-[0.65rem] font-medium tracking-[0.45em] uppercase"
      >
        ✦ Welcome ✦
      </span>
      <span class="bg-taupe-200 h-px flex-1"></span>
    </div>
  </div>

  <!-- ============================================ -->
  <!--               WELCOME BLOCK                   -->
  <!-- ============================================ -->
  <div
    class="relative mx-auto grid max-w-7xl grid-cols-12 items-center gap-y-14 px-6 pt-20 pb-28 lg:gap-x-14 lg:px-16 lg:pt-24"
  >
    <!-- IMAGE -->
    <div class="relative col-span-12 lg:col-span-5">
      <!-- offset sage frame, opposite direction from hero -->
      <div
        aria-hidden="true"
        class="border-sage-400/70 absolute -right-5 -bottom-5 -z-10 hidden h-full w-full border lg:block"
      >
      </div>
      <div
        class="relative overflow-hidden rounded-sm shadow-[0_30px_60px_-25px_rgba(60,49,40,0.4)]"
      >
        {
          welcomeImage && (
            <Image
              src={welcomeImage}
              class="block aspect-[4/5] h-full w-full object-cover"
              alt={homeData.welcome.alt}
              loading={'eager'}
              decoding="sync"
              fetchpriority="high"
              lqip="base64"
              lqipSize={10}
            />
          )
        }
      </div>

      <!-- corner ornament -->
      <svg
        aria-hidden="true"
        class="text-copper-500/40 absolute -top-6 -left-6 hidden h-16 w-16 lg:block"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      >
        <path d="M2 2 L2 30 M2 2 L30 2"></path>
        <circle cx="2" cy="2" r="2" fill="currentColor" stroke="none"></circle>
      </svg>
    </div>

    <!-- COPY -->
    <div class="col-span-12 lg:col-span-7 lg:pl-4">
      <div class="flex items-center gap-3">
        <span class="bg-sage-600 h-px w-8"></span>
        <span
          class="text-sage-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
        >
          About the clinic
        </span>
      </div>

      <h2
        class="text-taupe-900 mt-5 font-serif text-[clamp(2rem,4.4vw,3.25rem)] leading-[1.05] tracking-[-0.01em]"
      >
        Welcome to
        <em class="text-copper-600 font-serif italic">Glow and Relax</em>
        Studio by SMP
      </h2>

      <p class="text-taupe-700 mt-6 max-w-xl text-base leading-7">
        {homeData.welcome.body}
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        <li class="flex items-start gap-3">
          <span aria-hidden="true" class="bg-copper-500 mt-2 h-1 w-6 flex-none"
          ></span>
          <span class="text-taupe-700 text-sm leading-6">
            Restorative · Evidence-based care
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span aria-hidden="true" class="bg-sage-500 mt-2 h-1 w-6 flex-none"
          ></span>
          <span class="text-taupe-700 text-sm leading-6">
            Tailored to your body's needs
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span aria-hidden="true" class="bg-copper-500 mt-2 h-1 w-6 flex-none"
          ></span>
          <span class="text-taupe-700 text-sm leading-6">
            Local Canadian business
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span aria-hidden="true" class="bg-sage-500 mt-2 h-1 w-6 flex-none"
          ></span>
          <span class="text-taupe-700 text-sm leading-6">
            Reduce pain · Release tension
          </span>
        </li>
      </ul>

      <a
        href="/about"
        class="group border-taupe-900 text-taupe-900 hover:bg-taupe-900 hover:text-cream-50 mt-9 inline-flex items-center gap-2 rounded-full border px-6 py-3 text-sm font-medium transition-colors"
      >
        Learn More
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1">→</span
        >
      </a>
    </div>
  </div>
</section>

<style>
  /* Use Fraunces serif w/ refined optical sizing inside hero */
  #hero h1,
  #hero h2,
  #hero .font-serif,
  #hero em {
    font-family: 'Fraunces', 'Cormorant Garamond', ui-serif, Georgia, serif;
    font-feature-settings: 'ss01', 'ss02';
    font-variation-settings:
      'opsz' 144,
      'SOFT' 50;
  }

  #hero h1 .italic,
  #hero h2 em {
    font-variation-settings:
      'opsz' 144,
      'SOFT' 100;
  }

  /* Staggered entrance */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-rise {
    animation: hero-rise 0.95s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-rise-img {
    animation-duration: 1.2s;
    animation-delay: 0s;
  }
  .hero-rise-1 {
    animation-delay: 0.05s;
  }
  .hero-rise-2 {
    animation-delay: 0.15s;
  }
  .hero-rise-3 {
    animation-delay: 0.3s;
  }
  .hero-rise-4 {
    animation-delay: 0.4s;
  }
  .hero-rise-5 {
    animation-delay: 0.5s;
  }
  .hero-rise-6 {
    animation-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
    }
  }
</style>
