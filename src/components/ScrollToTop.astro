---
// This component assumes that your layout has an element with id="main"
---

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>

<a
  id="backToTop"
  href="#main"
  class="fixed bottom-15 right-5 opacity-0 focus-visible:opacity-100 transition-[opacity_color_background_background-color] duration-500 p-4 z-50 bg-(--primary) rounded-full text-gray-900 hover:bg-black hover:text-white"
  aria-label="Back to top"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-chevrons-up"
    ><path d="m17 11-5-5-5 5"></path><path d="m17 18-5-5-5 5"></path></svg
  >
</a>

<script>
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();

    const main = document.getElementById('main');
    const backToTop = document.getElementById('backToTop');
    if (!main || !backToTop) return;

    let mainBottom = 0;
    let viewportHeight = 0;
    let wasNearBottom: boolean | undefined;

    const checkScroll = () => {
      const isNearBottom = window.scrollY + viewportHeight >= mainBottom - 100;
      if (isNearBottom === wasNearBottom) return;
      wasNearBottom = isNearBottom;
      backToTop.classList.toggle('opacity-100', isNearBottom);
      backToTop.classList.toggle('opacity-0', !isNearBottom);
    };

    const updateLayout = () => {
      mainBottom = main.offsetTop + main.offsetHeight;
      viewportHeight = window.innerHeight;
      checkScroll();
    };

    const resizeObserver = new ResizeObserver(updateLayout);
    resizeObserver.observe(main);
    resizeObserver.observe(document.body);
    window.addEventListener('scroll', checkScroll, { passive: true });
    window.addEventListener('resize', updateLayout);
    updateLayout();

    cleanup = () => {
      resizeObserver.disconnect();
      window.removeEventListener('scroll', checkScroll);
      window.removeEventListener('resize', updateLayout);
    };
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
