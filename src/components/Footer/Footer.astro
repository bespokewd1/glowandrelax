---
import client from '@data/clientData';
import { getNavData } from '@data/navData';
import { getCurrentYear } from '@js/utils';
import MainLogo from '@assets/images/logo/glow-n-relax.png';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const currentYear = getCurrentYear();

const navData = await getNavData();
const servicesNode = navData.find((e) => e.key === 'Services');
const services = Array.isArray(servicesNode?.children)
  ? servicesNode.children
  : [];
---

<!-- ============================================ -->
<!--                   Footer                     -->
<!-- ============================================ -->
<footer
  id="footer"
  class="bg-sage-700 text-cream-50 relative isolate overflow-hidden"
>
  <!-- Ambient color washes -->
  <div
    aria-hidden="true"
    class="bg-copper-500/10 pointer-events-none absolute -top-32 -right-32 -z-10 h-[36rem] w-[36rem] rounded-full blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="bg-sage-500/30 pointer-events-none absolute -bottom-40 -left-40 -z-10 h-[34rem] w-[34rem] rounded-full blur-3xl"
  >
  </div>

  <!-- Grain -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.06] mix-blend-overlay"
    xmlns="http://www.w3.org/2000/svg"
  >
    <filter id="footer-noise">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        stitchTiles="stitch"></feTurbulence>
    </filter>
    <rect width="100%" height="100%" filter="url(#footer-noise)"></rect>
  </svg>

  <!-- Concentric ornament -->
  <svg
    aria-hidden="true"
    class="text-sage-500/30 pointer-events-none absolute -top-16 -right-20 hidden h-80 w-80 lg:block"
    viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
  >
    <circle cx="100" cy="100" r="92"></circle>
    <circle cx="100" cy="100" r="74"></circle>
    <circle cx="100" cy="100" r="56"></circle>
    <circle cx="100" cy="100" r="38"></circle>
    <circle cx="100" cy="100" r="20"></circle>
  </svg>

  <!-- Vertical brand tagline -->
  <span
    aria-hidden="true"
    class="text-copper-300/70 pointer-events-none absolute top-24 left-6 hidden text-[0.65rem] font-medium tracking-[0.45em] uppercase [writing-mode:vertical-rl] lg:block"
  >
    Glow · Relax · Restore
  </span>

  <!-- ============================================ -->
  <!--          Top hero band                        -->
  <!-- ============================================ -->
  <div
    class="relative mx-auto max-w-7xl px-6 pt-20 pb-10 md:px-10 md:pt-24 lg:px-16"
  >
    <div class="grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-12">
      <!-- LEFT: brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <span class="bg-copper-300 h-px w-8"></span>
          <span
            class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
          >
            Glow & Relax · Studio
          </span>
        </div>

        <a href="/" class="mt-7 inline-flex" aria-label="Back to home">
          <Image
            src={MainLogo}
            class="h-auto w-44 brightness-0 invert"
            alt="Glow and Relax logo"
          />
        </a>

        <p
          class="font-serif text-2xl leading-[1.15] tracking-[-0.01em] text-cream-50 mt-6 italic md:text-3xl"
        >
          A quiet retreat for body, mind &amp;
          <em class="text-copper-300 italic">balance.</em>
        </p>

        <p class="text-cream-100/85 mt-5 max-w-md text-sm leading-7">
          Restorative massage and bodywork in Edmonton — registered care,
          tailored to your body's needs.
        </p>

        <!-- Socials -->
        <div class="mt-8 flex items-center gap-3">
          <a
            href={client.socials.facebook}
            aria-label="Facebook"
            class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
          >
            <Icon
              name="tabler:brand-facebook-filled"
              class="h-5 w-5 text-cream-50"
              aria-hidden="true"
            />
          </a>
          <a
            href={client.socials.instagram}
            aria-label="Instagram"
            class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
          >
            <Icon
              name="tabler:brand-instagram"
              class="h-5 w-5 text-cream-50"
              aria-hidden="true"
            />
          </a>
          <a
            href={client.socials.linkedin}
            aria-label="LinkedIn"
            class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
          >
            <Icon
              name="tabler:brand-linkedin"
              class="h-5 w-5 text-cream-50"
              aria-hidden="true"
            />
          </a>
          <a
            href={client.socials.twitter}
            aria-label="Twitter"
            class="border-cream-50/30 hover:border-copper-300 hover:bg-copper-300/10 flex h-10 w-10 items-center justify-center rounded-full border transition"
          >
            <Icon
              name="tabler:brand-twitter-filled"
              class="h-5 w-5 text-cream-50"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <!-- RIGHT: lists -->
      <div
        class="grid grid-cols-1 gap-y-12 sm:grid-cols-3 sm:gap-x-8 lg:col-span-7"
      >
        <!-- Information -->
        <div>
          <div class="flex items-center gap-3">
            <span class="bg-copper-300 h-px w-6"></span>
            <h2
              class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Information
            </h2>
          </div>
          <ul class="mt-7 space-y-3">
            {
              navData.map((entry) => (
                <li>
                  <a
                    href={entry.url}
                    class="footer-link group relative inline-block font-serif text-[0.95rem] tracking-tight text-cream-50/90 transition-colors hover:text-copper-300"
                  >
                    <span class="relative">
                      {entry.key}
                      <span
                        aria-hidden="true"
                        class="bg-copper-300 absolute -bottom-0.5 left-0 h-px w-0 transition-[width] duration-300 group-hover:w-full"
                      />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Services -->
        <div>
          <div class="flex items-center gap-3">
            <span class="bg-copper-300 h-px w-6"></span>
            <h2
              class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Services
            </h2>
          </div>
          <ul class="mt-7 space-y-3">
            {
              services.map((svc) => (
                <li>
                  <a
                    href={svc.url}
                    class="footer-link group relative inline-block font-serif text-[0.95rem] tracking-tight text-cream-50/90 transition-colors hover:text-copper-300"
                  >
                    <span class="relative">
                      {svc.key}
                      <span
                        aria-hidden="true"
                        class="bg-copper-300 absolute -bottom-0.5 left-0 h-px w-0 transition-[width] duration-300 group-hover:w-full"
                      />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <div class="flex items-center gap-3">
            <span class="bg-copper-300 h-px w-6"></span>
            <h2
              class="text-copper-200 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
            >
              Contact
            </h2>
          </div>
          <ul class="text-cream-100/90 mt-7 space-y-4 text-sm leading-6">
            <li>
              <a
                href="/contact"
                class="hover:text-copper-300 group inline-block transition-colors"
              >
                {client.address.lineOne}<br />
                {client.address.lineTwo}<br />
                {client.address.city}
                {client.address.state}
                {client.address.zip}
              </a>
            </li>
            <li>
              <a
                href={`tel:${client.phoneForTel}`}
                class="hover:text-copper-300 inline-flex items-baseline gap-2 transition-colors"
              >
                <span class="text-copper-300 text-[0.7rem] font-medium tracking-[0.3em] uppercase"
                  >P.</span
                >
                <span>{client.phoneFormatted}</span>
              </a>
            </li>
            <li>
              <a
                href={`mailto:${client.email}`}
                class="hover:text-copper-300 inline-flex items-baseline gap-2 transition-colors"
              >
                <span class="text-copper-300 text-[0.7rem] font-medium tracking-[0.3em] uppercase"
                  >E.</span
                >
                <span>Click to Email</span>
              </a>
            </li>
            <li class="border-cream-100/15 mt-2 border-t pt-4">
              <span class="text-copper-300 text-[0.7rem] font-medium tracking-[0.3em] uppercase"
                >Hours.</span
              >
              <span class="ml-2"
                >{client.openingHours.daysOpen}: {client.openingHours.hours}</span
              >
            </li>
            <li>
              <p
                class="text-cream-100/65 text-xs leading-5 italic"
              >
                Direct billing available — please ask about eligible providers.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative divider -->
  <div class="relative mx-auto max-w-7xl px-6 md:px-10 lg:px-16">
    <div class="flex items-center gap-6">
      <span class="bg-cream-100/15 h-px flex-1"></span>
      <span
        class="text-cream-100/60 text-[0.65rem] font-medium tracking-[0.45em] uppercase"
      >
        ✦ Stay Well ✦
      </span>
      <span class="bg-cream-100/15 h-px flex-1"></span>
    </div>
  </div>

  <!-- ============================================ -->
  <!--          Bottom credit strip                  -->
  <!-- ============================================ -->
  <div
    class="relative mx-auto max-w-7xl px-6 py-10 md:px-10 lg:px-16"
  >
    <div
      class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center"
    >
      <p class="text-cream-100/70 text-xs leading-6">
        <span class="text-copper-300 text-[0.65rem] font-medium tracking-[0.4em] uppercase"
          >©&nbsp;{currentYear}</span
        >
        <span class="ml-2">{client.name} — All rights reserved.</span>
      </p>

      <p class="text-cream-100/70 text-xs leading-6">
        <span class="text-cream-100/60">Designed &amp; hand coded by</span>
        <a
          href="https://bespokewebdesign.ca/"
          target="_blank"
          rel="noopener"
          class="text-copper-300 hover:text-copper-200 group relative ml-1 inline-block transition-colors"
        >
          <span class="relative">
            Bespoke Web Design Edmonton
            <span
              aria-hidden="true"
              class="bg-copper-300 absolute -bottom-0.5 left-0 h-px w-0 transition-[width] duration-300 group-hover:w-full"
            ></span>
          </span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Refined serif optical sizing inside the footer */
  #footer .font-serif,
  #footer em {
    font-family:
      'Fraunces',
      'Cormorant Garamond',
      ui-serif,
      Georgia,
      serif;
    font-feature-settings: 'ss01', 'ss02';
    font-variation-settings:
      'opsz' 144,
      'SOFT' 50;
  }
  #footer em {
    font-variation-settings:
      'opsz' 144,
      'SOFT' 100;
  }
</style>
