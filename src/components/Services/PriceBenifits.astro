---
import Button from '@components/Button.astro';
import CtaLink from '@components/CtaLink.astro';
import clientData from '@data/clientData';

export interface ServiceBenefit {
  num: string;
  title: string;
  body: string;
}

export interface ServicePriceRow {
  duration: string;
  price: string;
}

export interface ServicePriceGroup {
  title: string;
  prices: Array<ServicePriceRow>;
}

export interface PriceBenefitsProps {
  benefitsTitle: string;
  benefits: Array<ServiceBenefit>;
  benefitsTagline: string;
  prices: Array<ServicePriceGroup> | Array<ServicePriceRow>;
  ctaLabel: string;
}

const { benefitsTitle, benefits, benefitsTagline, prices, ctaLabel } =
  Astro.props as PriceBenefitsProps;

// Normalize: accept both grouped (ServicePriceGroup[]) and flat (ServicePriceRow[]) formats
const isFlatFormat =
  Array.isArray(prices) && prices.length > 0 && 'duration' in prices[0];
const safeGroups: Array<ServicePriceGroup> =
  !Array.isArray(prices) || prices.length === 0
    ? []
    : isFlatFormat
      ? [{ title: '', prices: prices as unknown as Array<ServicePriceRow> }]
      : (prices as unknown as Array<ServicePriceGroup>).filter(
          (g) => g.prices && g.prices.length > 0
        );

// Italic accent on last word of benefits title
const titleWords = benefitsTitle.trim().split(/\s+/);
const titleAccent = titleWords.length > 1 ? titleWords.pop()! : benefitsTitle;
const titleLead = titleWords.join(' ');

const phoneDisplay = clientData.phoneFormatted?.trim() || '(587) 938-0458';
const phoneHref = `tel:${clientData.phoneForTel?.replace(/\s+/g, '') || '5879380458'}`;
const email = clientData.email || 'info@yourclinic.ca';
---

<!-- ============================== Benefits ============================== -->
<section class="bg-cream-100">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20 lg:px-12">
    <header class="mx-auto max-w-3xl text-center">
      <div class="mb-4 flex items-center justify-center gap-3">
        <span class="bg-copper-500 h-px w-8"></span>
        <span
          class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
        >
          Benefits
        </span>
        <span class="bg-copper-500 h-px w-8"></span>
      </div>
      <h2
        class="text-taupe-900 font-serif text-3xl tracking-[-0.01em] md:text-4xl lg:text-5xl"
      >
        {titleLead}{' '}
        <em class="text-copper-600 font-serif italic">{titleAccent}</em>
      </h2>
    </header>

    <div
      class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8"
    >
      {
        benefits.map((b) => (
          <article class="group border-taupe-200 bg-cream-50 hover:border-copper-400 relative overflow-hidden rounded-sm border px-8 py-10 text-center transition-all hover:-translate-y-1 hover:shadow-[0_30px_50px_-25px_rgba(60,49,40,0.35)]">
            <div
              aria-hidden="true"
              class="text-copper-500/10 pointer-events-none absolute top-2 right-2 font-serif text-[6rem] leading-none italic select-none"
            >
              {b.num}
            </div>
            <div class="relative">
              <div class="border-copper-500 text-copper-600 mx-auto flex h-12 w-12 items-center justify-center rounded-full border font-serif text-xl italic">
                {b.num}
              </div>
              <h3 class="text-taupe-900 mt-5 font-serif text-xl tracking-tight md:text-2xl">
                {b.title}
              </h3>
              <p class="text-taupe-700 mt-3 text-sm leading-6">{b.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Tagline -->
    <p
      class="text-taupe-900 mx-auto mt-12 max-w-2xl text-center font-serif text-xl italic md:text-2xl"
    >
      {benefitsTagline}
    </p>
  </div>
</section>

<!-- ============================== Prices ============================== -->
{
  safeGroups.length > 0 && (
    <section class="bg-cream-50">
      <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
        <header class="text-center">
          <div class="mb-4 flex items-center justify-center gap-3">
            <span class="bg-sage-600 h-px w-8" />
            <span class="text-sage-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase">
              Investment
            </span>
            <span class="bg-sage-600 h-px w-8" />
          </div>
          <h3 class="text-taupe-900 font-serif text-3xl tracking-[-0.01em] md:text-4xl">
            Session <em class="text-copper-600 font-serif italic">Options</em>
          </h3>
          <p class="text-taupe-700 mx-auto mt-4 max-w-xl text-sm leading-6">
            All prices are tax-included. Rates reflect in-clinic sessions by
            licensed therapists.
          </p>
        </header>

        {
          safeGroups.map((group) => (
            <div class="mt-10">
              {
                group.title && (
                  <h4 class="text-taupe-900 font-serif text-xl tracking-tight md:text-2xl mb-6">
                    {group.title}
                  </h4>
                )
              }
              <ul class="mx-auto max-w-2xl">
                {group.prices.map((row) => (
                  <li class="border-taupe-200 flex items-baseline justify-between gap-6 border-b py-5">
                    <span class="text-copper-600 font-serif text-lg italic md:text-xl">
                      {row.duration}
                    </span>
                    <span class="text-taupe-900 font-serif text-2xl tracking-tight md:text-3xl">
                      {row.price}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <p class="text-taupe-600 mx-auto mt-6 max-w-xl text-center text-xs leading-5">
          Need a different duration? Contact us and we'll help tailor a session
          to your needs.
        </p>

        <div class="mt-10 flex justify-center">
          <CtaLink>{ctaLabel}</CtaLink>
        </div>
      </div>
    </section>
  )
}

<!-- ============================== Contact strip ============================== -->
<section class="bg-cream-100">
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-14">
    <div
      class="flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left"
    >
      <div>
        <p
          class="text-copper-700 text-[0.65rem] font-medium tracking-[0.4em] uppercase"
        >
          Questions?
        </p>
        <p class="text-taupe-900 mt-2 font-serif text-xl italic md:text-2xl">
          We're here to help you choose the right session.
        </p>
        <p class="text-taupe-700 mt-2 text-sm">
          Call or text{' '}
          <a
            href={phoneHref}
            class="text-copper-700 decoration-copper-400 hover:text-copper-600 underline underline-offset-4 transition-colors"
          >
            {phoneDisplay}
          </a>{' '}
          ·{' '}
          <a
            href={`mailto:${email}`}
            class="text-copper-700 decoration-copper-400 hover:text-copper-600 underline underline-offset-4 transition-colors"
          >
            {email}
          </a>
        </p>
      </div>
      <Button as="a" href="/contact" variant="outline"> Ask a Question </Button>
    </div>
  </div>
</section>
