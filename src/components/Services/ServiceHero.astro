---
import Button from '@components/Button.astro';
import { Image } from 'astro-lqip/components';

export interface HeroServiceProps {
  title: string;
  image: ImageMetadata;
  alt: string;
  subtitle: string;
  highlights: Array<{ title: string; body: string }>;
  ctaPrimary: { label: string; href?: string };
  ctaSecondary: { label?: string; href?: string };
}

const { title, image, alt, subtitle, highlights, ctaPrimary, ctaSecondary } =
  Astro.props as HeroServiceProps;

// Split title — italicize last word for editorial accent
const titleWords = title.trim().split(/\s+/);
const titleAccent = titleWords.length > 1 ? titleWords.pop()! : title;
const titleLead = titleWords.join(' ');
---

<section
  id="service-hero"
  class="bg-cream-50 text-taupe-800 relative isolate overflow-hidden"
>
  <!-- Ambient color washes -->
  <div
    aria-hidden="true"
    class="bg-copper-200/40 pointer-events-none absolute -top-40 -left-40 -z-10 h-[36rem] w-[36rem] rounded-full blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="bg-sage-200/40 pointer-events-none absolute -right-40 -bottom-48 -z-10 h-[34rem] w-[34rem] rounded-full blur-3xl"
  >
  </div>

  <!-- Vertical brand label -->
  <div
    aria-hidden="true"
    class="text-copper-700/70 pointer-events-none absolute top-1/2 right-4 z-20 hidden -translate-y-1/2 rotate-180 text-[0.65rem] font-medium tracking-[0.45em] uppercase [writing-mode:vertical-rl] lg:block"
  >
    Glow · Relax · Restore
  </div>

  <div
    class="relative mx-auto grid max-w-7xl grid-cols-12 items-center gap-y-14 px-6 pt-14 pb-20 lg:gap-x-12 lg:px-16 lg:pt-20 lg:pb-28"
  >
    <!-- LEFT: copy -->
    <div class="relative col-span-12 lg:col-span-6">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3">
        <span class="bg-copper-500 h-px w-10"></span>
        <span
          class="text-copper-700 text-[0.7rem] font-medium tracking-[0.4em] uppercase"
        >
          Therapeutic Care
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="text-taupe-900 mt-6 font-serif text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] tracking-[-0.01em]"
      >
        {titleLead && <span class="block">{titleLead}</span>}
        <em class="text-copper-600 block font-serif italic">{titleAccent}</em>
      </h1>

      <!-- Subtitle -->
      <p class="text-taupe-700 mt-6 max-w-xl text-base leading-7">
        {subtitle}
      </p>

      <!-- CTAs -->
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button as="a" href={ctaPrimary.href ?? '/direct-billing/'}>
          {ctaPrimary.label}
        </Button>
        <Button as="a" href={ctaSecondary.href ?? '/contact'} variant="outline">
          {ctaSecondary.label ?? 'Ask a Question'}
        </Button>
      </div>

      <!-- Highlights — 3-col DL: serif italic copper number + uppercase taupe label + small body -->
      {
        highlights.length > 0 && (
          <dl class="border-taupe-200 mt-12 grid grid-cols-3 gap-4 border-t pt-7">
            {highlights.slice(0, 3).map((h, i) => (
              <div>
                <dt class="text-copper-600 font-serif text-2xl italic">
                  {`0${i + 1}`}
                </dt>
                <dd class="text-taupe-600 mt-2 text-[0.65rem] font-medium tracking-[0.3em] uppercase">
                  {h.title}
                </dd>
                <dd class="text-taupe-700 mt-1 hidden text-xs leading-5 md:block">
                  {h.body}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <!-- RIGHT: image with offset copper frame + corner ornament -->
    <div class="relative col-span-12 lg:col-span-6">
      <!-- offset frame -->
      <div
        aria-hidden="true"
        class="border-copper-400/70 absolute -inset-0 -z-10 hidden -translate-x-5 -translate-y-5 border lg:block"
      >
      </div>

      <div
        class="relative overflow-hidden rounded-sm shadow-[0_30px_70px_-25px_rgba(60,49,40,0.45)]"
      >
        <Image
          src={image}
          alt={alt}
          class="block aspect-[4/5] h-full w-full object-cover lg:aspect-[5/6]"
          loading={'eager'}
          decoding="sync"
          fetchpriority="high"
          lqip="base64"
          lqipSize={10}
        />
      </div>

      <!-- corner ornament L-shape -->
      <svg
        aria-hidden="true"
        class="text-copper-500/40 absolute -top-6 -left-6 hidden h-16 w-16 lg:block"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      >
        <path d="M2 2 L2 30 M2 2 L30 2"></path>
        <circle cx="2" cy="2" r="2" fill="currentColor" stroke="none"></circle>
      </svg>
    </div>
  </div>

  <!-- Decorative /01 watermark -->
  <div
    aria-hidden="true"
    class="text-copper-500/15 pointer-events-none absolute right-6 -bottom-4 font-serif text-[7rem] leading-none italic select-none lg:right-16 lg:text-[10rem]"
  >
    /01
  </div>
</section>
