---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils';
import { Icon } from 'astro-icon/components';

type Variant = 'primary' | 'secondary' | 'outline';

type CommonProps = {
  variant?: Variant;
  class?: string;
  icon?: string;
};

type AsAnchor = CommonProps & { as: 'a'; href: string } & Omit<
    HTMLAttributes<'a'>,
    'href' | 'class'
  >;

type AsButton = CommonProps & { as?: 'button' } & Omit<
    HTMLAttributes<'button'>,
    'class'
  >;

type Props = AsAnchor | AsButton;

const props = Astro.props as Props;
const {
  variant = 'primary',
  class: className,
  as = 'button',
  icon = 'tabler:arrow-right',
  ...rest
} = props;
const Tag = as === 'a' ? 'a' : 'button';

const variantClasses: Record<
  Variant,
  { btn: string; iconWrap: string; iconSvg: string }
> = {
  primary: {
    btn: 'bg-copper-600 hover:bg-copper-700 text-white shadow-[inset_0_0_1.6em_-0.6em_var(--color-copper-700)]',
    iconWrap:
      'bg-white shadow-[0.1em_0.1em_0.6em_0.2em_var(--color-copper-700)]',
    iconSvg: 'text-copper-700',
  },
  secondary: {
    btn: 'bg-sage-600 hover:bg-sage-700 text-white shadow-[inset_0_0_1.6em_-0.6em_var(--color-sage-700)]',
    iconWrap: 'bg-white shadow-[0.1em_0.1em_0.6em_0.2em_var(--color-sage-700)]',
    iconSvg: 'text-sage-700',
  },
  outline: {
    btn: 'bg-transparent text-taupe-900 shadow-[inset_0_0_0_1px_var(--color-copper-900)]',
    iconWrap: 'bg-copper-100 shadow-[inset_0_0_0_1px_var(--color-taupe-900)]',
    iconSvg: 'text-taupe-900',
  },
};
const v = variantClasses[variant];

const baseBtn = [
  'group/button relative inline-flex items-center overflow-hidden font-medium text-sm',
  'h-[2.8em] tracking-[0.05em] rounded-[0.9em] ',
  'pl-[1.2em] pr-[3.3em] py-[0.35em] cursor-pointer ',
  'border-0 font-sans transition-colors duration-200',
];
const iconWrap =
  'icon-wrapper absolute right-[0.3em] top-1/2 -translate-y-1/2 ' +
  'flex items-center justify-center h-[2.2em] w-[2.2em] rounded-[0.7em] ' +
  'transition-transform duration-300 ease-out group-active/button:scale-95';

const iconSvg =
  'w-[1.1em] transition-transform duration-300 ease-out group-hover/button:translate-x-[0.1em]';
---

<Tag class={cn(baseBtn, v.btn, className)} {...rest as Record<string, unknown>}>
  <slot />
  <span class={cn(iconWrap, v.iconWrap)}>

    <Icon class={cn(iconSvg, v.iconSvg)} name={icon} />
  </span>
</Tag>
