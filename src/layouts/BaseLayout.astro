---
import { ClientRouter } from 'astro:transitions';
import client from '@data/clientData';
import ScrollToTop from '@components/ScrollToTop.astro';
import '@styles/root.less';
// import '@styles/dark.less';
import '../styles/global.css';

import { getOptimizedImage } from '@js/utils';

import type { GetImageResult } from 'astro';
import { resolveImage } from '@js/imageUtils';
import seoSetting from '@data/seo-pages.json';
import Header from '@components/Header/EditorialHeader.astro';
import HybridFooter from '@components/Footer/HybridFooter.astro';
const ogImg = await resolveImage(seoSetting.global.ogImage);
let defaultOgImg: GetImageResult | null = null;
if (ogImg) {
  defaultOgImg = await getOptimizedImage(ogImg);
}

const siteOrigin = client.domain.startsWith('http')
  ? client.domain.replace(/\/+$/, '')
  : `https://${client.domain.replace(/^\/+|\/+$/g, '')}`;
const siteUrl = Astro.site ?? new URL(siteOrigin);

type Props = {
  description?: string;
  title?: string;
  preloadedImage?: GetImageResult | GetImageResult[];
  ogImage?: GetImageResult | null;
};

const { preloadedImage } = Astro.props;
const title = Astro.props.title?.trim() || seoSetting.global.title;
const description =
  Astro.props.description?.trim() || seoSetting.global.description;
const ogImage = Astro.props.ogImage ?? defaultOgImg;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage.src, siteOrigin).href : null;

const preloadedImages = !preloadedImage
  ? []
  : Array.isArray(preloadedImage)
    ? preloadedImage
    : [preloadedImage];

const fontCss =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..900,0..100;1,9..144,300..900,0..100&family=Mona+Sans:ital,wght@0,200..900;1,200..900&display=swap';
---

<!-- A fully fleshed-out <head>, dynamically changing based on client.json and the page front matter -->
<html lang="en">
  <head>
    <!-- View Transitions support -->
    <ClientRouter />

    <!-- Site metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load font CSS without blocking render; text paints in the fallback
         immediately (display=swap) and swaps when the web fonts arrive. -->
    <link rel="preload" as="style" href={fontCss} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href={fontCss} />
    </noscript>

    <link rel="canonical" href={canonicalUrl} />

    <!-- Preloads the image passed as a prop -->
    {
      preloadedImages.map((img) => (
        <link rel="preload" href={img.src} as="image" />
      ))
    }
    <!-- Social media previews -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={client.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:secure_url" content={ogImageUrl} />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- App icons -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png"
    />
    <link rel="manifest" href="/assets/favicons/site.webmanifest" />
    <meta name="theme-color" content="#435b47" />

    <title>{`${title} | ${client.name}`}</title>

    <!-- Sitewide Scripts -->
    <script src="@js/nav.js"></script>

    <meta
      name="google-site-verification"
      content="rY3pdndNZg05EqokbLe7sL-On46hh_9Ilc1xAisvbb0"
    />
  </head>
  <body>
    <!--Screen reader skip main nav-->
    <a class="skip" aria-label="skip to main content" href="#main"
      >Click To Skip To Main Content</a
    >

    <Header />
    <main id="main" class="relative">
      <slot />

      <ScrollToTop />
    </main>
    <HybridFooter />
  </body>
</html>
